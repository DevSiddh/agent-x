GITHUB_TOKEN=                  # system default token (Agent-XYZ's own account)
GITHUB_WEBHOOK_SECRET=
DEEPSEEK_API_KEY=
CONFIDENCE_THRESHOLD=0.85
CHURN_THRESHOLD=15
MAX_RETRIES=3
CI_POLL_TIMEOUT=300
ERROR_WINDOW_LINES=50
WEBHOOK_PORT=8080
HEALTHCHECK_URL=
NTFY_TOPIC=
WORKSPACE_ROOT=                # absolute path on VPS where Orchestrator creates projects

# Telegram
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_CHAT_ID=              # from @userinfobot

# Loop control (FIX-11)
PLAN_APPROVAL_TIMEOUT=600      # seconds to wait for user plan approval (default 10 min)

# Multi-user GitHub (FIX-3b / v4.1)
# Users can override GITHUB_TOKEN in their brief.yaml
# If brief.yaml has github_token: "ghp_xxx" → repos created in their account
# If not provided → uses GITHUB_TOKEN above → repos in system account

# Pytest timeout tiers (FIX-2)
TEST_TIMEOUT_FILE=30      # seconds per file-level test run (retries stay fast)
TEST_TIMEOUT_FULL=600     # seconds for full suite at iteration audit (FIX-13)

# Plan checkpoint timeout (FIX-11)
PLAN_APPROVAL_TIMEOUT=600     # seconds to wait for Telegram approval before auto-approving
